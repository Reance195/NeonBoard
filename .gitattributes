# 默认按文本处理，仓库内统一 LF，工作区检出为 LF
* text=auto eol=lf

# Windows 脚本保持 CRLF，保证 PowerShell / 批处理正常执行
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.iss text eol=crlf

# Git hooks 必须是 LF，否则在 sh 下无法执行
.githooks/* text eol=lf
*.sh text eol=lf

# 二进制资源，禁止行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.bmp binary
*.pdf binary
*.zip binary
*.7z binary
*.exe binary
*.dll binary
*.lib binary
*.pdb binary
*.qm binary
