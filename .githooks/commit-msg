#!/bin/sh
# ============================================================
# NeonBoard 仓库钩子 —— commit-msg
# 作用：约束提交信息格式，便于追溯
# 格式：<type>(<scope>): <subject>
#   type：feat fix chore docs refactor perf test build ci style revert
#   scope：可省略
#   subject：中文简述，不超过 50 字
# ============================================================

# python 判定与处置文案的唯一实现（DX-147：审计类 fail-closed，禁止静默放行）
. "$(dirname "$0")/pygate.sh"

allowed_types="feat fix chore docs refactor perf test build ci style revert merge"

message_file="$1"
if [ -z "$message_file" ] || [ ! -f "$message_file" ]; then
  exit 0
fi

first_line=$(sed -n '1p' "$message_file" | tr -d '\r')

# 合并进行中：放行 Git 自动生成的默认合并信息（如 "Merge branch 'x' into main"）
git_dir=$(git rev-parse --git-dir)
if [ -f "$git_dir/MERGE_HEAD" ]; then
  case "$first_line" in
    Merge\ *|merge:*|Merge\ pull*) exit 0 ;;
  esac
fi

# 跳过注释行与空信息
if [ -z "$first_line" ]; then
  echo ""
  echo " ❌ 提交信息不能为空。"
  echo ""
  echo " 格式：<type>(<scope>): <subject>"
  echo " 示例：feat(board): 增加卡片按标签筛选"
  echo ""
  exit 1
fi

# 解析 type 与可选 scope
head_part=$(echo "$first_line" | sed -E 's/^([a-zA-Z]+)(\([^)]*\))?:.*$/\1/')
scope_part=$(echo "$first_line" | sed -nE 's/^[a-zA-Z]+\(([^)]*)\):.*$/\1/p')

type_ok=0
for t in $allowed_types; do
  if [ "$head_part" = "$t" ]; then
    type_ok=1
    break
  fi
done

if [ "$type_ok" -eq 0 ]; then
  echo ""
  echo " ❌ 提交信息格式不符合规范。"
  echo ""
  echo " 当前：$first_line"
  echo ""
  echo " 格式：<type>(<scope>): <subject>"
  echo " type：feat fix chore docs refactor perf test build ci style revert"
  echo " 示例：feat(board): 增加卡片按标签筛选"
  echo "       fix(model): 修复删除后统计芯片未刷新"
  echo ""
  echo " 紧急情况可使用 git commit --no-verify 跳过本钩子。"
  echo ""
  exit 1
fi

# scope 若存在则不允许为空
if echo "$first_line" | grep -qE '^[a-zA-Z]+\(\):' ; then
  echo ""
  echo " ❌ scope 不能为空。"
  echo ""
  echo " 示例：feat(board): 增加卡片按标签筛选"
  echo "       若不需要 scope，请写成 feat: 增加卡片按标签筛选"
  echo ""
  exit 1
fi

# ---- 规则 3：代码改动必须关联任务卡 ----
# 豁免只看路径（docs/ scripts/ .githooks/ .github/ *.md 等），不看人怎么声明；
# feat/fix/refactor/perf/test 即使只碰豁免路径也必须有卡。
if nb_py_probe; then
  repo_top=$(git rev-parse --show-toplevel 2>/dev/null)
  if [ -n "$repo_top" ] && [ -f "$repo_top/scripts/task_gate.py" ]; then
    "$NB_PY" "$repo_top/scripts/task_gate.py" message --file "$message_file" || exit 1
  fi
elif nb_staged_is_exempt; then
  echo ""
  echo " ⚠ python 不可用：本次仅杂务路径改动，跳过任务关联校验（提交信息格式校验不受影响）"
  echo ""
elif nb_in_progress_state; then
  echo ""
  echo " ⚠ python 不可用：合并/rebase 续行中间态，跳过任务关联校验（该提交首次落定时已过闸门）"
  echo ""
else
  nb_py_block "代码改动任务关联校验"
  exit 1
fi

exit 0
