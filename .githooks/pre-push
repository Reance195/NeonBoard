#!/bin/sh
# ============================================================
# NeonBoard 仓库钩子 —— pre-push
# 作用：确保「未合并回主分支」的成果不会被推走
# 规则：
#   1. 功能分支必须已合并进 main 才允许推送（refs/claims/* 领用占位除外；
#      refs/tags/* 是发布触发器，改按「标签指向的提交必须在主线上」判定）
#   2. main 的推送必须是快进，禁止强推覆盖历史
#   3. 进度快照 progress.json 语义闸门：版本不得降级、卡片数不得减少、code 不得丢失
# ============================================================

remote_name="$1"
remote_url="$2"
main_branch="main"
zero="0000000000000000000000000000000000000000"

is_protected() {
  case "$1" in
    main|master|develop) return 0 ;;
    *) return 1 ;;
  esac
}

# ============================================================
# 规则 4：进度快照语义闸门（fail-closed）
# progress.json 是路线图快照，v3 格式（每张卡带 code 字段）。
# 写者唯一 = 看板应用（RoadmapSync 自动写回），禁止手改文件。
# 推送到主分支时校验：版本不得降级、卡片数不得减少、code 字段不得丢失。
# ============================================================
check_snapshot() {
  local local_sha="$1" remote_sha="$2"

  # 任一侧没有快照文件 → 无从校验，放行
  git cat-file -e "$local_sha:progress.json" 2>/dev/null || return 0
  git cat-file -e "$remote_sha:progress.json" 2>/dev/null || return 0

  local lv rv
  lv=$(git show "$local_sha:progress.json" 2>/dev/null | grep -o '"version"[[:space:]]*:[[:space:]]*[0-9]*' | head -1 | grep -o '[0-9]*')
  rv=$(git show "$remote_sha:progress.json" 2>/dev/null | grep -o '"version"[[:space:]]*:[[:space:]]*[0-9]*' | head -1 | grep -o '[0-9]*')
  [ -n "$lv" ] || lv=0
  [ -n "$rv" ] || rv=0

  if [ "$lv" -lt 3 ]; then
    echo ""
    echo "==================================================================="
    echo " ❌ 进度快照版本降级（本地 version=$lv < 3），已阻止推送。"
    echo "==================================================================="
    echo ""
    echo " progress.json 是 v3 格式（每张卡带 code 字段），不得退回 v2。"
    echo " 正确做法：让看板应用（RoadmapSync）写回快照，不要手改文件。"
    echo ""
    exit 1
  fi

  local li ri lc rc
  li=$(git show "$local_sha:progress.json" 2>/dev/null | grep -c '"id"[[:space:]]*:')
  ri=$(git show "$remote_sha:progress.json" 2>/dev/null | grep -c '"id"[[:space:]]*:')
  lc=$(git show "$local_sha:progress.json" 2>/dev/null | grep -c '"code"[[:space:]]*:')
  rc=$(git show "$remote_sha:progress.json" 2>/dev/null | grep -c '"code"[[:space:]]*:')

  if [ "$li" -lt "$ri" ]; then
    echo ""
    echo "==================================================================="
    echo " ❌ 进度快照卡片数减少（$li < $ri），已阻止推送。"
    echo "==================================================================="
    echo ""
    echo " 移除的卡片应写成 \"deleted\": true，而不是从快照里删条目。"
    echo ""
    exit 1
  fi

  if [ "$rv" -ge 3 ] && [ "$lc" -lt "$rc" ]; then
    echo ""
    echo "==================================================================="
    echo " ❌ 进度快照 code 字段丢失（$lc < $rc），已阻止推送。"
    echo "==================================================================="
    echo ""
    echo " v3 快照每张卡都带 code；丢失说明用旧格式覆盖了主线快照。"
    echo ""
    exit 1
  fi
}

# stdin: <local_ref> <local_sha> <remote_ref> <remote_sha>
# 注意：最后一个字段会带上行尾换行符，必须清理后再比较
while read -r local_ref local_sha remote_ref remote_sha; do
  local_ref=$(printf '%s' "$local_ref" | tr -d '\r\n')
  local_sha=$(printf '%s' "$local_sha" | tr -d '\r\n')
  remote_ref=$(printf '%s' "$remote_ref" | tr -d '\r\n')
  remote_sha=$(printf '%s' "$remote_sha" | tr -d '\r\n')

  # 跳过删除远程分支的场景
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi

  # 领用占位 refs/claims/<短号> 是服务端占用 ref（agent-init 领用时推送），
  # 不是分支推送，不受「必须合并进 main」限制。
  # 立卡占位 refs/registrations/<短号>（DX-104）同理：它指向唯一的 off-main
  # 空提交（刻意不在主线历史），按「必须已合并」判定必被拒 —— 这里必须豁免。
  case "$remote_ref" in
    refs/claims/*) continue ;;
    refs/registrations/*) continue ;;
  esac

  # 发布标签 refs/tags/* 是 release.yml 的触发器，不是分支推送，同样不受
  # 「必须合并进 main」限制 —— 但它比规则 1 更该被拦：标签指向的提交一旦不在
  # 主线上，CI 就会拿去打一个主线里不存在的构建（§7.8 闸门 2 的精神）。
  # 所以这里不是放行，是换成「标签所指提交必须已在主线上」这条对偶判据。
  # 附注标签的 local_sha 是 tag 对象，必须先剥到提交对象再判祖先，
  # 否则 merge-base 拿到的是 tag 对象，判据恒假、正常发布也推不上去。
  case "$remote_ref" in
    refs/tags/*)
      tagged=$(git rev-parse -q --verify "${local_sha}^{commit}" 2>/dev/null)
      [ -n "$tagged" ] || tagged="$local_sha"
      # 判据以 origin/main 为准（与「重开门」同源）：本地 main 可能是旧的，
      # 按本地判会把已经合进主线的提交当成不在主线上。取不到才退回本地 main。
      tag_base="$main_branch"
      if git rev-parse --verify -q "origin/$main_branch" >/dev/null 2>&1; then
        tag_base="origin/$main_branch"
      fi
      if git rev-parse --verify -q "$tag_base" >/dev/null 2>&1; then
        if ! git merge-base --is-ancestor "$tagged" "$tag_base" 2>/dev/null; then
          echo ""
          echo "==================================================================="
          echo " ❌ 标签 '${remote_ref#refs/tags/}' 指向的提交不在 '$tag_base' 上，禁止推送。"
          echo "==================================================================="
          echo ""
          echo " 本仓库宪章要求：发布物必须来自主线（AGENTS.md §7.8 闸门 2）。"
          echo " 先把它合进 $main_branch，再在主线提交上重新打标签："
          echo "   git fetch origin"
          echo "   git tag -d ${remote_ref#refs/tags/}"
          echo "   git -c core.hooksPath=.githooks tag -a ${remote_ref#refs/tags/} origin/main -m '...'"
          echo "   git push origin ${remote_ref#refs/tags/}"
          echo ""
          exit 1
        fi
      fi
      continue ;;
  esac

  branch=$(echo "$local_ref" | sed 's#^refs/heads/##')
  remote_branch=$(echo "$remote_ref" | sed 's#^refs/heads/##')

  # ---- 规则 3：推送到主分支（含 git push origin HEAD:main 的合并推送）----
  # 多代理并行时，合并不再依赖主 worktree：agent 在自己的 worktree 里
  # 基于 origin/main 做 --no-ff 合并后，直接把结果快进推送到主分支。
  # 这类推送的目标就是主分支，因此按快进规则校验后放行。
  if is_protected "$remote_branch"; then
    if [ "$remote_sha" != "$zero" ]; then
      if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        echo ""
        echo "==================================================================="
        echo " ❌ 推送到主分支 '$remote_branch' 不是快进更新，已阻止。"
        echo "==================================================================="
        echo ""
        echo " 请先拉取远程最新提交并重新合并："
        echo "   git fetch origin"
        echo "   git rebase origin/$remote_branch"
        echo ""
        echo " 严禁对主分支使用 --force / --force-with-lease。"
        echo ""
        exit 1
      fi
    fi
    # 规则 4：进度快照语义闸门（版本 / 卡片数 / code 字段）
    check_snapshot "$local_sha" "$remote_sha"

    # ---- 规则 5：任务闸门（推主干的最后一道硬门）----
    # 本地开关都能被绕过，只有这里能挡住「手搓分支 → 手工 merge → 直推 main」。
    # 逐个校验推送范围内触及代码路径的提交：必须带任务号，且有服务端 claim ref 占位。
    if command -v python >/dev/null 2>&1; then
      repo_top=$(git rev-parse --show-toplevel 2>/dev/null)
      if [ -n "$repo_top" ] && [ -f "$repo_top/scripts/task_gate.py" ]; then
        python "$repo_top/scripts/task_gate.py" push --remote "$remote_sha" --local "$local_sha" || exit 1
      fi
    else
      echo ""
      echo "==================================================================="
      echo " ❌ 未找到 python，无法校验任务凭据，已阻止推送到主分支。"
      echo "==================================================================="
      echo ""
      echo " 任务闸门依赖 python；请先安装并确保 python 在 PATH 中。"
      echo ""
      exit 1
    fi
    continue
  fi

  # ---- 规则 2：主分支推送必须快进 ----
  if is_protected "$branch"; then
    if [ "$remote_sha" != "$zero" ]; then
      if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        echo ""
        echo "==================================================================="
        echo " ❌ 主分支 '$branch' 的推送不是快进更新，已阻止。"
        echo "==================================================================="
        echo ""
        echo " 请先拉取远程最新提交并合并后再推送："
        echo "   git pull --no-rebase origin $branch"
        echo "   git push origin $branch"
        echo ""
        echo " 严禁对主分支使用 --force / --force-with-lease。"
        echo ""
        exit 1
      fi
    fi
    continue
  fi

  # ---- 规则 1：功能分支必须已合并进 main ----
  if git rev-parse --verify -q "$main_branch" >/dev/null 2>&1; then
    if ! git merge-base --is-ancestor "$local_sha" "$main_branch" 2>/dev/null; then
      echo ""
      echo "==================================================================="
      echo " ❌ 分支 '$branch' 尚未合并进 '$main_branch'，禁止推送。"
      echo "==================================================================="
      echo ""
      echo " 本仓库宪章要求：改动必须先合并回主分支才能对外发布。"
      echo ""
      echo " 正确流程："
      echo "   git switch $main_branch"
      echo "   git merge --no-ff $branch"
      echo "   git branch -d $branch"
      echo "   git push origin $branch    # 推送合并后的主分支"
      echo ""
      exit 1
    fi
  fi
done

exit 0
